# macOS
.DS_Store
**/.DS_Store

# Editors / IDEs
.vscode/
.idea/
*.swp
*~

# Claude Code local settings (machine-specific + may contain secrets in permission rules)
.claude/settings.local.json

# Environment files — never commit secrets
.env
.env.local
.env.*.local
mobile_app/.env
mobile_app/.env.*
mobile_app/ios/.xcode.env.local

# Database dumps with real user data
data.sql
schema.sql

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Expo
.expo/
.expo-shared/
dist/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro / Expo prebuild artifacts
.metro-health-check*

# iOS
mobile_app/ios/Pods/
mobile_app/ios/build/
mobile_app/ios/DerivedData/
mobile_app/ios/Podfile.lock.bak
**/xcuserdata/
**/*.xcuserstate
**/Build/
**/Index.noindex/

# Android (if you add it later)
mobile_app/android/build/
mobile_app/android/app/build/
mobile_app/android/.gradle/
mobile_app/android/local.properties

# Supabase CLI local state (machine-specific)
supabase/.temp/
supabase/.branches/

# Logs
*.log
logs/

# Python (test.py + any other scripts)
__pycache__/
*.py[cod]
.venv/
venv/

# Misc
*.tsbuildinfo
.next/
coverage/
